[Unit]
Description=shrooms overlay mesh
Documentation=https://github.com/vpavlin/shrooms
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/shrooms daemon
# `systemctl reload shrooms` re-reads the config and applies what can be
# applied while running — the published services. Everything else is reported
# as needing a restart rather than silently ignored.
ExecReload=/bin/kill -HUP $MAINPID

# CAP_NET_ADMIN to create the TUN device and configure its address and route.
#
# CAP_NET_BIND_SERVICE for the resolver on port 53. Running as root is not
# enough: the bounding set removes every capability not listed, so without this
# the bind fails with EACCES on a process that is otherwise privileged — which
# reads as a permissions bug in the wrong place entirely.
# CAP_CHOWN is for socket_group and nothing else: the daemon gives the control
# socket, and the runtime directory it sits in, to the group named in the
# config so that `shrooms status` and a desktop app do not need sudo. Running
# as root is not enough for that — a bounding set without CAP_CHOWN makes
# chown fail with EPERM even for uid 0, which is exactly what happened here:
# the setting appeared to work, the log said it had, and every attempt to read
# status still failed with permission denied.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_CHOWN
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_CHOWN

StateDirectory=shrooms
StateDirectoryMode=0700
ConfigurationDirectory=shrooms
RuntimeDirectory=shrooms
RuntimeDirectoryMode=0750

# liblogosdelivery and friends are installed alongside the binary rather than
# into a system library path, so they do not collide with anything.
Environment=LD_LIBRARY_PATH=/usr/local/lib/shrooms

NoNewPrivileges=yes
ProtectSystem=strict

# ProtectSystem=strict makes /etc read-only, which would silently defeat
# manage_hosts. Narrowly re-opened to the one file, so the daemon can keep peer
# names current without gaining write access to the rest of /etc.
ReadWritePaths=/etc/hosts
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX

# The Waku node reconnects on its own; restart covers process-level failures.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
