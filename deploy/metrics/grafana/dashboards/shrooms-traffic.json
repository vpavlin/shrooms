  {
   "type": "row",
   "title": "Tunnels — shrooms between peers",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 30
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Tunnel traffic per peer (as each machine counts it)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 16,
    "x": 0,
    "y": 31
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (node, mesh, peer) (rate(shrooms_peer_receive_bytes_total[5m]) + rate(shrooms_peer_transmit_bytes_total[5m]))",
     "legendFormat": "{{node}} ↔ {{peer}} ({{mesh}})",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "type": "bargauge",
   "title": "Tunnels, last 24 h per mesh",
   "description": "Each tunnel counted at both ends.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 8,
    "x": 16,
    "y": 31
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (mesh) (increase(shrooms_peer_receive_bytes_total[24h]) + increase(shrooms_peer_transmit_bytes_total[24h]))",
