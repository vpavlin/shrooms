{
 "uid": "shrooms-traffic",
 "title": "shrooms — where the bytes go",
 "tags": [
  "shrooms"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Machines — what the router sees (physical interfaces)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Traffic per machine",
   "description": "Every physical interface of each machine, in (up) and out (down). The sum over machines on one LAN is roughly what its router counts.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 16,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (node) (rate(shrooms_host_receive_bytes_total{interface!~\"(logos|shrooms|docker|veth|br-|virbr|podman|cni|vnet|tun|tap|wg|flannel|lxc|tailscale).*\"}[5m]))",
     "legendFormat": "{{node}} in",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "-sum by (node) (rate(shrooms_host_transmit_bytes_total{interface!~\"(logos|shrooms|docker|veth|br-|virbr|podman|cni|vnet|tun|tap|wg|flannel|lxc|tailscale).*\"}[5m]))",
     "legendFormat": "{{node}} out",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "type": "bargauge",
   "title": "Last 24 h per machine (in + out)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 8,
    "x": 16,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (node) (increase(shrooms_host_receive_bytes_total{interface!~\"(logos|shrooms|docker|veth|br-|virbr|podman|cni|vnet|tun|tap|wg|flannel|lxc|tailscale).*\"}[24h]) + increase(shrooms_host_transmit_bytes_total{interface!~\"(logos|shrooms|docker|veth|br-|virbr|podman|cni|vnet|tun|tap|wg|flannel|lxc|tailscale).*\"}[24h]))",
     "legendFormat": "{{node}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    }
   }
  },
  {
   "type": "stat",
   "title": "All machines, last 24 h",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(shrooms_host_receive_bytes_total{interface!~\"(logos|shrooms|docker|veth|br-|virbr|podman|cni|vnet|tun|tap|wg|flannel|lxc|tailscale).*\"}[24h]) + increase(shrooms_host_transmit_bytes_total{interface!~\"(logos|shrooms|docker|veth|br-|virbr|podman|cni|vnet|tun|tap|wg|flannel|lxc|tailscale).*\"}[24h]))",
     "legendFormat": "total",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "type": "stat",
   "title": "…of which delivery (rendezvous plane)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 6,
    "y": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(shrooms_delivery_bytes_total[24h]))",
     "legendFormat": "delivery",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "type": "stat",
   "title": "…of which shrooms tunnels",
   "description": "Counted at both ends of each tunnel, and riding the physical interfaces of each.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 12,
    "y": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(shrooms_peer_receive_bytes_total[24h]) + increase(shrooms_peer_transmit_bytes_total[24h]))",
     "legendFormat": "tunnels",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "type": "stat",
   "title": "Delivery share of physical traffic",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 18,
    "y": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(shrooms_delivery_bytes_total[24h])) / sum(increase(shrooms_host_receive_bytes_total{interface!~\"(logos|shrooms|docker|veth|br-|virbr|podman|cni|vnet|tun|tap|wg|flannel|lxc|tailscale).*\"}[24h]) + increase(shrooms_host_transmit_bytes_total{interface!~\"(logos|shrooms|docker|veth|br-|virbr|podman|cni|vnet|tun|tap|wg|flannel|lxc|tailscale).*\"}[24h]))",
     "legendFormat": "share",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "type": "row",
   "title": "Delivery — the rendezvous plane (a Core node relays for the whole cluster)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 14
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Delivery traffic per machine",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 16,
    "x": 0,
    "y": 15
