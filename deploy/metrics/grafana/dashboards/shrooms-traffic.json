   },
   "gridPos": {
    "h": 6,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "shrooms_delivery_peers",
     "legendFormat": "{{node}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Delivery messages per second",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 6,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (node) (rate(shrooms_delivery_messages_total[5m]))",
     "legendFormat": "{{node}}",
     "datasource": {
      "type": "prometheus",
