    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (node) (rate(shrooms_delivery_bytes_total{direction=\"in\"}[5m]))",
     "legendFormat": "{{node}} in",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "-sum by (node) (rate(shrooms_delivery_bytes_total{direction=\"out\"}[5m]))",
     "legendFormat": "{{node}} out",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "type": "bargauge",
   "title": "Delivery, last 24 h per machine",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 8,
    "x": 16,
    "y": 15
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (node) (increase(shrooms_delivery_bytes_total[24h]))",
     "legendFormat": "{{node}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    }
   }
  },
  {
