<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To read the underlying network's DNS servers. Without it
         getLinkProperties throws, and a resolver that cannot forward must not
         be installed at all — see MeshVpnService.underlyingDnsServers. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only to scan a network key from another device's screen. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Voice notes to agents, transcribed on the owner's own machine. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Reading a Keycard, so the mesh's admin key can live on a card rather
         than on a device (ADR-022). Foreground only: Android reads NFC while a
         screen is in front, which is why signing is a deliberate tap. -->
    <uses-permission android:name="android.permission.NFC" />
    <!-- required="false": a phone without NFC is still a perfectly good mesh
         member, it just cannot be the admin. -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- There is no VPN-specific foreground service type; specialUse is the
         documented fallback for one that does not fit the listed categories. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- So the mesh comes back after a reboot without opening the app. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- So the watchdog's restart comes back in seconds: an exact alarm may
         start a foreground service from the background, where Android delays
         or refuses a sticky restart (10 minutes away from the mesh,
         2026-10-06). USE_EXACT_ALARM is granted at install on Android 13+;
         SCHEDULE_EXACT_ALARM before that. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />

    <!-- The shrooms app opens Shrooms Agents (docs/agents.md); Android 11+
         hides other apps unless they are named here. -->
    <queries>
        <package android:name="xyz.vpavlin.shrooms.agents" />
        <!-- Shrooms Agents' voice section names the installed speech engines
             and opens SherpaTTS (Speech, docs/agents-voices.md). -->
        <package android:name="org.woheller69.ttsengine" />
        <package android:name="org.fdroid.fdroid" />
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".ShroomsApp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The mesh on a home screen: state, reachable peers, and a way in
             and out. See ShroomsWidget. -->
        <!-- Exported, because it has to be: the system delivers
             APPWIDGET_UPDATE to it, and a provider it cannot reach is a widget
             that will not load. There is no custom action here for anything
             else to abuse — the buttons carry PendingIntents aimed straight at
             the service, which is not exported. -->
        <receiver
            android:name=".ShroomsWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- Bring the tunnel up after a reboot or an update, when consent has
             already been given. See BootReceiver. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- The agents watcher, for the preview build, which has no VPN
             service to host it (AgentWatch.kt). -->
        <service
            android:name=".AgentWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Notifies the owner when an AI agent on one of their own machines needs approval or has replied, over their private mesh." />
        </service>

        <service
            android:name=".MeshVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains an encrypted overlay network between the user's own devices." />
        </service>
    </application>
</manifest>
