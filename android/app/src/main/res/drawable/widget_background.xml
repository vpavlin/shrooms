<?xml version="1.0" encoding="utf-8"?>
<!-- The app's own background, so a widget on a home screen reads as part of it
     rather than as a system panel that happens to mention shrooms. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0E1216" />
    <stroke android:width="1dp" android:color="#1C2229" />
    <corners android:radius="16dp" />
</shape>
